# Kamalデプロイ用の環境変数設定ファイル（テンプレート）
# 実際の値を設定したら、このファイルを .kamal/secrets にコピーしてください
# .kamal/secrets は .gitignore に含まれており、Gitにコミットされません

# Rails暗号化キー（config/master.key の内容）
RAILS_MASTER_KEY=your_rails_master_key_here

# PostgreSQLデータベースのパスワード
# VPS上で設定したPostgreSQLユーザー "flexitype" のパスワード
FLEXITYPE_DATABASE_PASSWORD=your_database_password_here

# オプション: ログイン許可メールアドレス（カンマ区切り）
# ベータ版リリース時は空文字列のままでOK（全員に制限メッセージ表示）
# ALLOWED_EMAILS=user1@example.com,user2@example.com
