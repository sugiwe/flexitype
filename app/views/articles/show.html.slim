/ SEO・OGPタグ
- content_for :page_title, @article.title
- content_for :meta_description, @article.meta_description
- content_for :og_type, "article"
- content_for :og_title, @article.title
- content_for :og_description, @article.meta_description
- content_for :og_url, article_url(@article)
- content_for :article_published_time, @article.published_at.iso8601
- content_for :article_author, @article.author_name

/ 記事ヘッダー
.mb-8
  / パンくずリスト
  .mb-4
    nav.flex aria-label="Breadcrumb"
      ol.inline-flex.items-center.space-x-1.md:space-x-3
        li.inline-flex.items-center
          = link_to articles_path, class: "text-gray-700 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400" do
            | 記事一覧
        li
          .flex.items-center
            svg.w-6.h-6.text-gray-400 fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"
            span.ml-1.text-gray-500.dark:text-gray-400 = @article.title

  / カテゴリーバッジ
  .mb-4
    = link_to articles_path(category: @article.category), class: "inline-block px-3 py-1 text-sm font-medium rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-800 transition" do
      = Article.human_attribute_name("category.#{@article.category}")

  / タイトルと管理者用編集ボタン
  .flex.justify-between.items-start.mb-4
    h1.text-4xl.font-bold.text-gray-900.dark:text-white
      = @article.title
    / 管理者用編集ボタン
    - if current_user&.admin?
      = link_to edit_admin_article_path(@article), class: "flex items-center gap-2 px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition text-sm" do
        svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
        | 編集

  / サムネイル画像（2:1アスペクト比）
  - if @article.thumbnail.attached?
    .overflow-hidden.rounded-lg.mb-6 class="aspect-[2/1]"
      = image_tag @article.thumbnail.variant(resize_to_fill: [1200, 600]), alt: @article.title, class: "w-full h-full object-cover"

  / メタ情報
  .flex.flex-wrap.items-center.gap-4.text-sm.text-gray-600.dark:text-gray-400.mb-6
    / 著者
    .flex.items-center.gap-2
      svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
      span = @article.author_name

    / 公開日
    .flex.items-center.gap-2
      svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
      time datetime=@article.published_at.iso8601
        = l(@article.published_at, format: :long)

    / 閲覧数
    .flex.items-center.gap-2
      svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
      span = number_with_delimiter(@article.view_count) + " 回閲覧"

/ 記事本文（Markdown）
article.prose.prose-lg.dark:prose-invert.max-w-none.bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-8.mb-8
  = markdown(@article.content)

/ シェアボタン（将来実装）
.bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6.mb-8
  h3.text-lg.font-bold.text-gray-900.dark:text-white.mb-4 この記事をシェア
  .flex.gap-4
    / Twitter/X シェアボタン
    = link_to "https://twitter.com/intent/tweet?text=#{CGI.escape(@article.title)}&url=#{CGI.escape(article_url(@article))}", target: "_blank", rel: "noopener noreferrer", class: "flex items-center gap-2 px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition" do
      svg.w-5.h-5 fill="currentColor" viewBox="0 0 24 24"
        path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
      | Xでシェア

/ 関連記事
- related_articles = Article.published.by_category(@article.category).where.not(id: @article.id).recent.limit(3)
- if related_articles.any?
  .mb-8
    h2.text-2xl.font-bold.text-gray-900.dark:text-white.mb-6 関連記事
    .grid.grid-cols-1.md:grid-cols-3.gap-6
      - related_articles.each do |related|
        = link_to article_path(related), class: "group bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-xl transition-shadow border border-gray-200 dark:border-gray-700 overflow-hidden" do
          .p-6
            h3.text-lg.font-bold.text-gray-900.dark:text-white.mb-2.group-hover:text-blue-600.dark:group-hover:text-blue-400.transition
              = related.title
            - if related.excerpt.present?
              p.text-sm.text-gray-600.dark:text-gray-400.line-clamp-2
                = related.excerpt
            .mt-4.text-xs.text-gray-500.dark:text-gray-400
              = l(related.published_at, format: :short)

/ 記事一覧へ戻るリンク
.text-center
  = link_to articles_path, class: "inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:underline" do
    svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
      path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"
    | 記事一覧へ戻る
