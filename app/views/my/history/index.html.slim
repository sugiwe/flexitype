/ ページヘッダー
.mb-6
  h2.text-3xl.font-bold.text-gray-800.dark:text-white 練習履歴
  p.text-sm.text-gray-600.dark:text-gray-400.mt-2 あなたのタイピング練習の記録を確認できます

= turbo_frame_tag "history_content" do
  / 期間フィルタータブ（Turbo Frames対応）
  .mb-6
    / タブナビゲーション
    .border-b.border-gray-200.dark:border-gray-700
      nav.-mb-px.flex.space-x-8 aria-label="Period tabs"
        = link_to my_history_index_path(period: 'all'), data: { turbo_frame: "history_content" }, class: "#{@period == 'all' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" do
          | 全期間

        = link_to my_history_index_path(period: 'month'), data: { turbo_frame: "history_content" }, class: "#{@period == 'month' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" do
          | 直近1ヶ月

        = link_to my_history_index_path(period: 'week'), data: { turbo_frame: "history_content" }, class: "#{@period == 'week' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" do
          | 直近1週間
  / 統計情報（ミニ版）
  .grid.grid-cols-1.md:grid-cols-3.gap-4.mb-6
    / 総練習回数
    .bg-white.dark:bg-gray-800.rounded-lg.shadow.p-6.transition-colors
      .flex.items-center.justify-between
        div
          p.text-sm.text-gray-600.dark:text-gray-400 総練習回数
          p.text-3xl.font-bold.text-blue-600.dark:text-blue-400.mt-2
            = @total_count
            span.text-lg.text-gray-500.dark:text-gray-400.ml-2 回
        svg.h-12.w-12.text-blue-500.dark:text-blue-400 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"

    / 平均正答率
    .bg-white.dark:bg-gray-800.rounded-lg.shadow.p-6.transition-colors
      .flex.items-center.justify-between
        div
          p.text-sm.text-gray-600.dark:text-gray-400 平均正答率
          p.text-3xl.font-bold.text-green-600.dark:text-green-400.mt-2
            = @average_accuracy
            span.text-lg.text-gray-500.dark:text-gray-400.ml-2 %
        svg.h-12.w-12.text-green-500.dark:text-green-400 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"

    / 平均WPM
    .bg-white.dark:bg-gray-800.rounded-lg.shadow.p-6.transition-colors
      .flex.items-center.justify-between
        div
          p.text-sm.text-gray-600.dark:text-gray-400 平均WPM
          p.text-3xl.font-bold.text-purple-600.dark:text-purple-400.mt-2
            = @average_wpm
            span.text-lg.text-gray-500.dark:text-gray-400.ml-2 WPM
        svg.h-12.w-12.text-purple-500.dark:text-purple-400 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"

  / 履歴一覧
  .bg-white.dark:bg-gray-800.rounded-lg.shadow.transition-colors
    - if @lesson_records.any?
      / テーブル（PC）
      .hidden.md:block
        table.w-full
          thead
            tr.border-b.border-gray-200.dark:border-gray-700
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider 日時
              th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider レッスン
              th.px-6.py-3.text-center.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider 単語数
              th.px-6.py-3.text-center.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider 正答率
              th.px-6.py-3.text-center.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider WPM
              th.px-6.py-3.text-center.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider グレード
              th.px-6.py-3.text-center.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider 所要時間
              th.px-6.py-3.text-center.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider ミス数
          tbody.divide-y.divide-gray-200.dark:divide-gray-700
            - @lesson_records.each do |record|
              tr.hover:bg-gray-50.dark:hover:bg-gray-700.transition-colors
                td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900.dark:text-gray-100
                  = l(record.completed_at, format: :short)
                td.px-6.py-4.text-sm
                  .font-medium.text-gray-900.dark:text-gray-100 = record.lesson_name
                  .text-xs.text-gray-500.dark:text-gray-400 = record.category
                td.px-6.py-4.whitespace-nowrap.text-center.text-sm.text-gray-900.dark:text-gray-100
                  = record.word_count
                td.px-6.py-4.whitespace-nowrap.text-center
                  - if record.accuracy && record.accuracy >= 90
                    span.inline-flex.px-2.py-1.text-sm.font-semibold.rounded-full.bg-green-100.dark:bg-green-900.text-green-800.dark:text-green-200
                      = "#{record.accuracy}%"
                  - elsif record.accuracy && record.accuracy >= 70
                    span.inline-flex.px-2.py-1.text-sm.font-semibold.rounded-full.bg-yellow-100.dark:bg-yellow-900.text-yellow-800.dark:text-yellow-200
                      = "#{record.accuracy}%"
                  - else
                    span.inline-flex.px-2.py-1.text-sm.font-semibold.rounded-full.bg-red-100.dark:bg-red-900.text-red-800.dark:text-red-200
                      = "#{record.accuracy}%"
                td.px-6.py-4.whitespace-nowrap.text-center.text-sm.text-gray-900.dark:text-gray-100
                  - if record.wpm
                    = record.wpm
                  - else
                    | -
                td.px-6.py-4.whitespace-nowrap.text-center.text-sm
                  - if record.grade.present?
                    .flex.items-center.justify-center.gap-1
                      span.text-lg = record.grade_emoji
                      span.text-gray-900.dark:text-gray-100 = record.grade.gsub('のカワウソ', '')
                  - else
                    span.text-gray-500.dark:text-gray-400 -
                td.px-6.py-4.whitespace-nowrap.text-center.text-sm.text-gray-900.dark:text-gray-100
                  - if record.duration_seconds
                    - minutes = record.duration_seconds / 60
                    - seconds = record.duration_seconds % 60
                    = "#{minutes}:#{seconds.to_s.rjust(2, '0')}"
                  - else
                    | -
                td.px-6.py-4.whitespace-nowrap.text-center.text-sm.text-gray-900.dark:text-gray-100
                  = record.mistake_count

      / カード（モバイル）
      .md:hidden.divide-y.divide-gray-200.dark:divide-gray-700
        - @lesson_records.each do |record|
          .p-4
            .flex.justify-between.items-start.mb-3
              div
                .font-medium.text-gray-900.dark:text-gray-100 = record.lesson_name
                .text-xs.text-gray-500.dark:text-gray-400.mt-1 = l(record.completed_at, format: :short)
              - if record.accuracy && record.accuracy >= 90
                span.inline-flex.px-2.py-1.text-sm.font-semibold.rounded-full.bg-green-100.dark:bg-green-900.text-green-800.dark:text-green-200
                  = "#{record.accuracy}%"
              - elsif record.accuracy && record.accuracy >= 70
                span.inline-flex.px-2.py-1.text-sm.font-semibold.rounded-full.bg-yellow-100.dark:bg-yellow-900.text-yellow-800.dark:text-yellow-200
                  = "#{record.accuracy}%"
              - else
                span.inline-flex.px-2.py-1.text-sm.font-semibold.rounded-full.bg-red-100.dark:bg-red-900.text-red-800.dark:text-red-200
                  = "#{record.accuracy}%"
            / グレード表示
            - if record.grade.present?
              .mb-3.flex.items-center.gap-2.text-sm
                span.text-2xl = record.grade_emoji
                span.font-medium.text-gray-900.dark:text-gray-100 = record.grade.gsub('のカワウソ', '')
            .grid.grid-cols-4.gap-2.text-sm.text-gray-600.dark:text-gray-400
              div
                span.text-xs 単語数
                .font-medium.text-gray-900.dark:text-gray-100.mt-1 = record.word_count
              div
                span.text-xs WPM
                .font-medium.text-gray-900.dark:text-gray-100.mt-1
                  - if record.wpm
                    = record.wpm
                  - else
                    | -
              div
                span.text-xs 所要時間
                .font-medium.text-gray-900.dark:text-gray-100.mt-1
                  - if record.duration_seconds
                    - minutes = record.duration_seconds / 60
                    - seconds = record.duration_seconds % 60
                    = "#{minutes}:#{seconds.to_s.rjust(2, '0')}"
                  - else
                    | -
              div
                span.text-xs ミス数
                .font-medium.text-gray-900.dark:text-gray-100.mt-1 = record.mistake_count

      / ページネーション
      .px-6.py-4.border-t.border-gray-200.dark:border-gray-700
        = paginate @lesson_records, params: { period: @period }

    - else
      / 履歴なし
      .p-12.text-center
        svg.mx-auto.h-12.w-12.text-gray-400.dark:text-gray-600 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        p.mt-4.text-gray-500.dark:text-gray-400 この期間の練習履歴がありません
        p.text-sm.text-gray-400.dark:text-gray-500.mt-2 タイピング練習を完了すると、ここに履歴が表示されます
        .mt-6
          = link_to "練習を始める", root_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
