/ キーマップ新規作成ページ
.max-w-2xl.mx-auto
  / ヘッダー
  .mb-6
    h1.text-2xl.font-bold.text-gray-800.dark:text-white.mb-2 = t('keymaps.new.title')
    p.text-gray-600.dark:text-gray-400 = t('keymaps.new.description')

  / フォーム
  = form_with model: @keymap_set, url: my_keymaps_path, class: "bg-white dark:bg-gray-800 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 p-6" do |f|
    / 基本情報フィールド
    = render "form_fields", f: f, keymap_set: @keymap_set, mode: :new

    / ボタン
    .flex.gap-3
      = f.submit t('keymaps.new.create'), class: "flex-1 px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition font-medium"
      = link_to t('keymaps.new.cancel'), my_keymaps_path, class: "flex-1 px-4 py-2 bg-gray-300 dark:bg-gray-600 text-gray-800 dark:text-white text-center rounded-lg hover:bg-gray-400 dark:hover:bg-gray-700 transition font-medium"
