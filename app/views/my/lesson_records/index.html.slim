/ ページヘッダー
.mb-6
  h2.text-3xl.font-bold.text-gray-800.dark:text-white = t('history.title')
  p.text-sm.text-gray-600.dark:text-gray-400.mt-2 = t('history.description')

= turbo_frame_tag "history_content" do
  / 期間フィルタータブ（Turbo Frames対応）
  .mb-6
    / タブナビゲーション + シェアボタン
    .border-b.border-gray-200.dark:border-gray-700.flex.items-center.justify-between
      nav.-mb-px.flex.space-x-8 aria-label="Period tabs"
        = link_to my_history_index_path(period: 'all'), data: { turbo_frame: "history_content" }, class: "#{@period == 'all' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" do
          = t('history.periods.all')

        = link_to my_history_index_path(period: 'month'), data: { turbo_frame: "history_content" }, class: "#{@period == 'month' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" do
          = t('history.periods.month')

        = link_to my_history_index_path(period: 'week'), data: { turbo_frame: "history_content" }, class: "#{@period == 'week' ? 'border-blue-500 text-blue-600 dark:text-blue-400' : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" do
          = t('history.periods.week')

      / 期間サマリーシェアボタン
      .flex.gap-2
        = button_to my_period_shares_path(period: 'today'), method: :post, data: { turbo: false }, form: { target: "_blank" }, class: "px-3 py-2 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 rounded-md transition-colors" do
          = t('history.share.today_button')
        .relative data-controller="dropdown"
          button.px-3.py-2.text-xs.font-medium.text-gray-700.dark:text-gray-300.bg-white.dark:bg-gray-700.border.border-gray-300.dark:border-gray-600.hover:bg-gray-50.dark:hover:bg-gray-600.rounded-md.transition-colors data-action="click->dropdown#toggle" type="button"
            = t('history.share.other_periods_button')
            svg.inline-block.ml-1.h-4.w-4 fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"
          .absolute.right-0.mt-2.w-48.bg-white.dark:bg-gray-700.rounded-md.shadow-lg.z-10.hidden data-dropdown-target="menu"
            .py-1
              = button_to my_period_shares_path(period: 'yesterday'), method: :post, data: { turbo: false }, form: { target: "_blank" }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600" do
                = t('history.share.periods.yesterday')
              = button_to my_period_shares_path(period: 'this_week'), method: :post, data: { turbo: false }, form: { target: "_blank" }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600" do
                = t('history.share.periods.this_week')
              = button_to my_period_shares_path(period: 'last_week'), method: :post, data: { turbo: false }, form: { target: "_blank" }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600" do
                = t('history.share.periods.last_week')
              = button_to my_period_shares_path(period: 'this_month'), method: :post, data: { turbo: false }, form: { target: "_blank" }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600" do
                = t('history.share.periods.this_month')
              = button_to my_period_shares_path(period: 'last_month'), method: :post, data: { turbo: false }, form: { target: "_blank" }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-600" do
                = t('history.share.periods.last_month')
  / 統計情報（ミニ版）
  .grid.grid-cols-1.md:grid-cols-3.gap-4.mb-6
    / 総練習回数
    .bg-white.dark:bg-gray-800.rounded-lg.shadow.p-6.transition-colors
      .flex.items-center.justify-between
        div
          p.text-sm.text-gray-600.dark:text-gray-400 = t('history.stats.total_practices')
          p.text-3xl.font-bold.text-blue-600.dark:text-blue-400.mt-2
            = @total_count
            span.text-lg.text-gray-500.dark:text-gray-400.ml-2 回
        svg.h-12.w-12.text-blue-500.dark:text-blue-400 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"

    / 平均正答率
    .bg-white.dark:bg-gray-800.rounded-lg.shadow.p-6.transition-colors
      .flex.items-center.justify-between
        div
          p.text-sm.text-gray-600.dark:text-gray-400 = t('history.stats.average_accuracy')
          p.text-3xl.font-bold.text-green-600.dark:text-green-400.mt-2
            = @average_accuracy
            span.text-lg.text-gray-500.dark:text-gray-400.ml-2 %
        svg.h-12.w-12.text-green-500.dark:text-green-400 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"

    / 平均WPM
    .bg-white.dark:bg-gray-800.rounded-lg.shadow.p-6.transition-colors
      .flex.items-center.justify-between
        div
          p.text-sm.text-gray-600.dark:text-gray-400 = t('history.stats.average_wpm')
          p.text-3xl.font-bold.text-purple-600.dark:text-purple-400.mt-2
            = @average_wpm
            span.text-lg.text-gray-500.dark:text-gray-400.ml-2 WPM
        svg.h-12.w-12.text-purple-500.dark:text-purple-400 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"

  / 履歴一覧
  .bg-white.dark:bg-gray-800.rounded-lg.shadow.transition-colors
    = render "shared/lesson_records_table", lesson_records: @lesson_records, show_pagination: true, pagination_params: { period: @period }, show_start_link: true, show_share_button: true
