/ ページヘッダー
.mb-6.flex.items-center.justify-between
  div
    h2.text-3xl.font-bold.text-gray-800.dark:text-white レッスン管理
    p.text-sm.text-gray-600.dark:text-gray-400.mt-2
      | 公式レッスン、自作レッスン、公開レッスンを確認・管理できます
  = link_to new_my_lesson_path, class: "px-6 py-3 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition font-semibold inline-flex items-center gap-2" do
    svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
      path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
    | 新規作成

/ レッスン一覧
- if @lessons.any?
  .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-6
    - @lessons.each do |lesson|
      .bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6.transition-colors.relative
        / 公式バッジ（公式レッスンのみ）
        - if lesson.official?
          .absolute.top-4.right-4.px-3.py-1.bg-blue-100.dark:bg-blue-900.text-blue-700.dark:text-blue-200.text-xs.rounded-full.font-semibold
            | 公式

        / カテゴリー
        .text-xs.text-gray-500.dark:text-gray-400.mb-2 = lesson.category.name

        / レッスン名
        h3.text-xl.font-bold.text-gray-800.dark:text-white.mb-2 = lesson.name

        / 説明
        p.text-sm.text-gray-600.dark:text-gray-300.mb-4.line-clamp-2 = lesson.description

        / 統計情報
        .grid.grid-cols-2.gap-3.mb-4.text-sm
          .flex.items-center.gap-2.text-gray-600.dark:text-gray-400
            svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            span = "#{lesson.items.count}単語"
          .flex.items-center.gap-2.text-gray-600.dark:text-gray-400
            svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"
            span = "#{lesson.count}問"

        / ステータスバッジ
        .flex.flex-wrap.gap-2.mb-4
          - if lesson.is_public
            .px-2.py-1.bg-green-100.dark:bg-green-900.text-green-700.dark:text-green-200.text-xs.rounded-full.font-semibold
              | 公開中
          - else
            .px-2.py-1.bg-gray-100.dark:bg-gray-700.text-gray-700.dark:text-gray-300.text-xs.rounded-full.font-semibold
              | 非公開
          - if lesson.requires_login
            .px-2.py-1.bg-yellow-100.dark:bg-yellow-900.text-yellow-700.dark:text-yellow-200.text-xs.rounded-full.font-semibold
              | ログイン必須
          - if lesson.premium
            .px-2.py-1.bg-purple-100.dark:bg-purple-900.text-purple-700.dark:text-purple-200.text-xs.rounded-full.font-semibold
              | 有料限定

        / アクション（自分のレッスンまたは管理者のみ編集・削除可能）
        - if lesson.user_id == current_user.id || current_user.admin?
          .flex.gap-2.pt-4.border-t.border-gray-200.dark:border-gray-700
            = link_to "練習する", lesson_path(id: lesson.id), class: "flex-1 px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white text-center rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition font-semibold text-sm", data: { turbo: false }
            = link_to edit_my_lesson_path(lesson), class: "px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition font-semibold text-sm" do
              | 編集
            = button_to my_lesson_path(lesson), method: :delete, data: { confirm: "本当に削除しますか？", turbo_confirm: "本当に削除しますか？" }, class: "px-4 py-2 bg-red-600 dark:bg-red-700 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600 transition font-semibold text-sm" do
              | 削除
        - else
          / 他人のレッスン（公開レッスン）は練習のみ可能
          = link_to "練習する", lesson_path(id: lesson.id), class: "block w-full px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white text-center rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition font-semibold text-sm", data: { turbo: false }

- else
  .text-center.py-12.bg-white.dark:bg-gray-800.rounded-lg.shadow-md
    svg.mx-auto.h-12.w-12.text-gray-400.dark:text-gray-600.mb-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
      path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
    p.text-gray-500.dark:text-gray-400.mb-4 レッスンがまだありません
    = link_to new_my_lesson_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition font-semibold" do
      svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
      | 最初のレッスンを作成
