= turbo_frame_tag "lesson_management_content" do
  / タブコンテンツ
  .space-y-8
    - lessons = lessons_for_tab(tab_key)
    - if lessons.any?
      / カテゴリーごとにグルーピング
      - lessons.group_by(&:category).each do |category, category_lessons|
        .bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6.transition-colors
          / カテゴリヘッダー
          .mb-4
            h2.text-2xl.font-bold.text-gray-800.dark:text-white = category.name
            p.text-gray-600.dark:text-gray-400.mt-1 = category.description

          / レッスンカード一覧（3列グリッドレイアウト）
          .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-4
            - category_lessons.each do |lesson|
              .bg-gradient-to-br.from-blue-50.to-indigo-50.dark:from-blue-900.dark:to-indigo-900.border-2.border-blue-200.dark:border-blue-700.rounded-lg.p-4.transition.flex.flex-col
                / レッスン情報
                .flex-1.mb-4
                  / ヘッダー
                  .mb-3
                    .flex.items-start.justify-between.gap-2.mb-2
                      h3.text-lg.font-semibold.text-gray-800.dark:text-white = lesson.name
                      / 公式バッジ
                      - if lesson.official?
                        span.px-2.py-1.bg-blue-100.dark:bg-blue-800.text-blue-800.dark:text-blue-200.text-xs.font-medium.rounded-full.shrink-0
                          | 公式
                    - if lesson.description.present?
                      p.text-sm.text-gray-600.dark:text-gray-300.line-clamp-2 = lesson.description
                    - else
                      p.text-sm.text-gray-500.dark:text-gray-500.italic 説明なし

                  / メタ情報
                  .flex.flex-wrap.items-center.gap-2.text-xs.text-gray-600.dark:text-gray-300
                    .flex.items-center.gap-1
                      svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"
                      span #{lesson.items.size} 項目
                    .flex.items-center.gap-1
                      svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                      span #{lesson.count} 問
                    / 公開状態
                    - if lesson.is_public
                      span.px-2.py-1.bg-green-100.dark:bg-green-800.text-green-800.dark:text-green-200.text-xs.font-medium.rounded-full
                        | 公開中
                    - else
                      span.px-2.py-1.bg-gray-100.dark:bg-gray-700.text-gray-600.dark:text-gray-300.text-xs.font-medium.rounded-full
                        | 非公開
                    - if lesson.requires_login
                      span.px-2.py-1.bg-yellow-100.dark:bg-yellow-800.text-yellow-700.dark:text-yellow-200.text-xs.font-medium.rounded-full
                        | ログイン必須
                    - if lesson.premium
                      span.px-2.py-1.bg-purple-100.dark:bg-purple-800.text-purple-700.dark:text-purple-200.text-xs.font-medium.rounded-full
                        | 有料限定

                / アクションボタン（自分のレッスンまたは管理者のみ表示）
                - if lesson.user_id == current_user.id || current_user.admin?
                  .flex.gap-2
                    = link_to edit_my_lesson_path(lesson), data: { turbo_frame: "_top" }, class: "flex-1 px-3 py-2 bg-blue-600 dark:bg-blue-700 text-white text-center rounded hover:bg-blue-700 dark:hover:bg-blue-800 transition text-sm" do
                      svg.w-4.h-4.inline-block.mr-1 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                      | 編集
                    = button_to my_lesson_path(lesson), method: :delete, data: { turbo_confirm: "レッスン「#{lesson.name}」を削除してもよろしいですか？" }, class: "flex-1 px-3 py-2 bg-gray-500 dark:bg-gray-600 text-white rounded hover:bg-gray-600 dark:hover:bg-gray-500 transition text-sm" do
                      svg.w-4.h-4.inline-block.mr-1 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      | 削除
    - else
      .bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-12.text-center
        .text-6xl.mb-4 📝
        h3.text-xl.font-bold.text-gray-800.dark:text-white.mb-2 レッスンがありません
        p.text-gray-600.dark:text-gray-400 このタブのレッスンは現在ありません。
