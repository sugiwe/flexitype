/ フラッシュメッセージコンテナ（右上固定）
.fixed.top-4.right-4.z-50.space-y-2.max-w-md.w-full.px-4 class="sm:px-0"
  - flash.each do |type, message|
    - next if message.blank?
    - bg_color = type == "notice" ? "bg-green-50 dark:bg-green-900 border-green-200 dark:border-green-700" : "bg-red-50 dark:bg-red-900 border-red-200 dark:border-red-700"
    - text_color = type == "notice" ? "text-green-800 dark:text-green-200" : "text-red-800 dark:text-red-200"
    - icon_color = type == "notice" ? "text-green-500 dark:text-green-400" : "text-red-500 dark:text-red-400"
    - progress_color = type == "notice" ? "bg-green-500 dark:bg-green-400" : "bg-red-500 dark:bg-red-400"

    .relative.rounded-lg.shadow-lg.border.overflow-hidden.transition-all.duration-300 class=bg_color data-controller="flash" data-flash-duration-value="5000"
      .flex.items-start.p-4
        / アイコン
        .flex-shrink-0
          - if type == "notice"
            svg.w-6.h-6 class=icon_color fill="none" stroke="currentColor" viewBox="0 0 24 24"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
          - else
            svg.w-6.h-6 class=icon_color fill="none" stroke="currentColor" viewBox="0 0 24 24"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"

        / メッセージテキスト
        .flex-1.ml-3 data-flash-target="message"
          p.text-sm.font-medium class=text_color = message

        / 閉じるボタン
        .flex-shrink-0.ml-4
          button.rounded-md.inline-flex.focus:outline-none.focus:ring-2.focus:ring-offset-2 class="#{icon_color} hover:#{text_color}" data-action="click->flash#close" type="button"
            span.sr-only 閉じる
            svg.w-5.h-5 fill="currentColor" viewBox="0 0 20 20"
              path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"

      / プログレスバー
      .absolute.bottom-0.left-0.w-full.h-1 class="#{bg_color}"
        .h-full.transition-all.duration-50 class=progress_color data-flash-target="progress" style="width: 0%"
