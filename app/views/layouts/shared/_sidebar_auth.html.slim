/ ユーザー情報・認証エリア（常に下部に固定）
.p-4.border-t.border-gray-200.dark:border-gray-700
  - if logged_in?
    / ログイン状態: ユーザーアイコン + テーマアイコン + ヘルプアイコン + ハンバーガー用スペース
    .flex.items-center.justify-between
      / ユーザーアイコン（左）
      .relative data-controller="user-menu"
        button.w-10.h-10.rounded-full.overflow-hidden.border-2.border-gray-300.dark:border-gray-600.hover:border-blue-500.dark:hover:border-blue-400.transition type="button" data-action="click->user-menu#toggle"
          - if current_user.icon_url.present?
            img src=current_user.icon_url alt=current_user.name class="w-full h-full object-cover"
          - else
            .w-full.h-full.bg-blue-600.dark:bg-blue-500.flex.items-center.justify-center.text-white.font-semibold
              = current_user.name[0].upcase

        / ユーザーメニュードロップダウン（上方向）
        .absolute.bottom-full.left-0.mb-2.w-64.bg-white.dark:bg-gray-700.rounded-lg.shadow-lg.border.border-gray-200.dark:border-gray-600.hidden data-user-menu-target="dropdown"
          .p-4.border-b.border-gray-200.dark:border-gray-600
            p.text-sm.font-semibold.text-gray-800.dark:text-white.truncate = current_user.name
            p.text-xs.text-gray-500.dark:text-gray-400.truncate = current_user.email
          .py-2
            / マイページ（設定ダッシュボード）
            = link_to my_root_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition" do
              | マイページ
            / 区切り線
            .border-t.border-gray-200.dark:border-gray-600.my-2
            / ログアウト
            = button_to logout_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
              | ログアウト

      / 右側アイコングループ（テーマ + ヘルプ + ハンバーガー用スペース）
      .flex.items-center.gap-2
        / テーマアイコン
        .relative data-controller="theme"
          button.w-10.h-10.bg-gray-100.dark:bg-gray-700.hover:bg-gray-200.dark:hover:bg-gray-600.rounded-full.flex.items-center.justify-center.text-gray-600.dark:text-gray-300.transition type="button" data-action="click->theme#toggle"
            span data-theme-target="currentIcon"
              svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"

          / テーマ選択ドロップダウン（上方向）
          .absolute.bottom-full.right-0.mb-2.w-40.bg-white.dark:bg-gray-700.rounded-lg.shadow-lg.border.border-gray-200.dark:border-gray-600.hidden data-theme-target="dropdown"
            .py-2
              button.w-full.px-4.py-2.text-left.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center type="button" data-action="click->theme#select" data-theme-id="light"
                span.mr-2
                  svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                span Light
              button.w-full.px-4.py-2.text-left.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center type="button" data-action="click->theme#select" data-theme-id="dark"
                span.mr-2
                  svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                span Dark
              button.w-full.px-4.py-2.text-left.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center type="button" data-action="click->theme#select" data-theme-id="system"
                span.mr-2
                  svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                span System

        / ヘルプアイコン
        .relative data-controller="help-menu"
          button.w-10.h-10.bg-gray-100.dark:bg-gray-700.hover:bg-gray-200.dark:hover:bg-gray-600.rounded-full.flex.items-center.justify-center.text-gray-600.dark:text-gray-300.transition type="button" data-action="click->help-menu#toggle"
            | ?

          / ヘルプメニュードロップダウン（上方向）
          .absolute.bottom-full.right-0.mb-2.w-48.bg-white.dark:bg-gray-700.rounded-lg.shadow-lg.border.border-gray-200.dark:border-gray-600.hidden data-help-menu-target="dropdown"
            .py-2
              = link_to about_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | Typnixについて
              .border-t.border-gray-200.dark:border-gray-600.my-2
              = link_to terms_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | 利用規約
              = link_to privacy_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | プライバシーポリシー
              a.block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition href="https://forms.gle/a6EYBBxhMdGc4TJq6" target="_blank" rel="noopener noreferrer"
                | お問い合わせ

        / ハンバーガーメニュー用スペース（モバイルのみ・幅確保のみ）
        .md:hidden class="w-10"

  - else
    / ログアウト状態
    - if Rails.env.development?
      / 開発環境: 簡易ログインへのリンク
      .bg-yellow-50.dark:bg-yellow-900.border.border-yellow-200.dark:border-yellow-700.rounded-lg.p-3.mb-2
        p.text-sm.font-semibold.text-yellow-800.dark:text-yellow-300.mb-2 開発環境
        = link_to dev_sessions_path, class: "block w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-center rounded-lg transition" do
          | 開発用ログイン
    - else
      / ベータ版制限中の情報表示（本番環境）
      .bg-blue-50.dark:bg-blue-900.border.border-blue-200.dark:border-blue-700.rounded-lg.p-2.mb-2.flex.items-center.gap-2
        svg.w-8.h-8.flex-shrink-0.text-blue-600.dark:text-blue-400 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
        .flex-grow
          p.text-sm.font-semibold.text-blue-800.dark:text-blue-300 ベータ版テスト中
          p.text-xs.text-blue-700.dark:text-blue-400 限定ユーザーのみログイン可能

      .bg-gray-100.dark:bg-gray-800.rounded-lg.p-2.mb-2
        p.text-xs.text-gray-600.dark:text-gray-400
          | ログイン希望者は
          a.text-blue-600.dark:text-blue-400.hover:underline.font-medium href="https://forms.gle/a6EYBBxhMdGc4TJq6" target="_blank" rel="noopener noreferrer"
            | こちらからご連絡ください

      / Googleログインボタン + ヘルプアイコン
      .flex.items-center.gap-2
        / Googleログインボタン（70%）
        .flex-grow data-controller="google-signin" data-google-signin-client-id-value=Rails.application.credentials.dig(:google, :client_id)
          .g_id_signin

        / ヘルプアイコン
        .relative data-controller="help-menu"
          button.w-10.h-10.bg-gray-100.dark:bg-gray-700.hover:bg-gray-200.dark:hover:bg-gray-600.rounded-full.flex.items-center.justify-center.text-gray-600.dark:text-gray-300.transition type="button" data-action="click->help-menu#toggle"
            | ?

          / ヘルプメニュードロップダウン（上方向）
          .absolute.bottom-full.right-0.mb-2.w-48.bg-white.dark:bg-gray-700.rounded-lg.shadow-lg.border.border-gray-200.dark:border-gray-600.hidden data-help-menu-target="dropdown"
            .py-2
              = link_to about_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | Typnixについて
              .border-t.border-gray-200.dark:border-gray-600.my-2
              = link_to terms_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | 利用規約
              = link_to privacy_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | プライバシーポリシー
              a.block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center.gap-1 href="https://forms.gle/a6EYBBxhMdGc4TJq6" target="_blank" rel="noopener noreferrer"
                span お問い合わせ
                svg.w-3.h-3 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"

        / ハンバーガーメニュー用スペース（モバイルのみ・幅確保のみ）
        .md:hidden class="w-10"

    / ヘルプアイコン（両環境共通）
    - unless Rails.env.development?
      .flex.items-center.gap-2.justify-end
        / ヘルプアイコン
        .relative data-controller="help-menu"
          button.w-10.h-10.bg-gray-100.dark:bg-gray-700.hover:bg-gray-200.dark:hover:bg-gray-600.rounded-full.flex.items-center.justify-center.text-gray-600.dark:text-gray-300.transition type="button" data-action="click->help-menu#toggle"
            | ?

          / ヘルプメニュードロップダウン（上方向）
          .absolute.bottom-full.right-0.mb-2.w-48.bg-white.dark:bg-gray-700.rounded-lg.shadow-lg.border.border-gray-200.dark:border-gray-600.hidden data-help-menu-target="dropdown"
            .py-2
              = link_to about_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | Typnixについて
              .border-t.border-gray-200.dark:border-gray-600.my-2
              = link_to terms_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | 利用規約
              = link_to privacy_path, class: "block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600 transition", data: { turbo: false } do
                | プライバシーポリシー
              a.block.px-4.py-2.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center.gap-1 href="https://forms.gle/a6EYBBxhMdGc4TJq6" target="_blank" rel="noopener noreferrer"
                span お問い合わせ
                svg.w-3.h-3 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"

        / ハンバーガーメニュー用スペース（モバイルのみ・幅確保のみ）
        .md:hidden class="w-10"
