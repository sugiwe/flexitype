doctype html
html
  head
    title = content_for(:title) || "Typnix"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Typnix"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/icon.png"

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    script src="https://accounts.google.com/gsi/client" async="" defer="" data-turbo-track="reload"

  body.h-screen.flex.bg-gray-50.overflow-hidden
    / 左カラムサイドバー（300px）
    aside.bg-white.shadow-lg.flex.flex-col.fixed.h-full.left-0.top-0.z-10 style="width: 300px;"
      / ロゴエリア
      .p-6.border-b.border-gray-200
        = link_to root_path, class: "block", data: { turbo: false } do
          h1.text-2xl.font-bold.text-gray-800 Typnix
          p.text-xs.text-gray-500.mt-1 分割型キーボード練習

      / ナビゲーションメニュー（スクロール可能エリア）
      nav.flex-1.p-4.overflow-y-auto
        ul.space-y-2
          li
            = link_to root_path, class: "flex items-center px-4 py-3 text-gray-700 rounded-lg hover:bg-blue-50 hover:text-blue-600 transition #{current_page?(root_path) ? 'bg-blue-50 text-blue-600 font-semibold' : ''}", data: { turbo: false } do
              svg.w-5.h-5.mr-3 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              span ホーム
          - if logged_in?
            li
              = link_to edit_keymap_path(id: 'current'), class: "flex items-center px-4 py-3 text-gray-700 rounded-lg hover:bg-blue-50 hover:text-blue-600 transition #{current_page?(edit_keymap_path(id: 'current')) ? 'bg-blue-50 text-blue-600 font-semibold' : ''}" do
                svg.w-5.h-5.mr-3 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                span キーマップ設定

      / 広告スペース（300x250px - レクタングル中）- 常に表示
      .border-t.border-gray-200.flex.items-center.justify-center
        .w-full.h-64.bg-gray-200.flex.items-center.justify-center
          .text-center
            p.text-xs.text-gray-400.font-semibold Ad Space
            p.text-xs.text-gray-400.mt-1 300 x 250

      / ユーザー情報・認証エリア（常に下部に固定）
      .p-4.border-t.border-gray-200
        - if logged_in?
          .mb-3
            .flex.items-center.mb-2
              .w-8.h-8.bg-blue-600.rounded-full.flex.items-center.justify-center.text-white.font-semibold.mr-2
                = current_user.name[0].upcase
              .flex-1
                p.text-sm.font-semibold.text-gray-800 = current_user.name
                p.text-xs.text-gray-500.truncate = current_user.email
          = button_to "ログアウト", logout_path, method: :delete, class: "w-full px-4 py-2 bg-gray-600 text-white text-sm rounded-lg hover:bg-gray-700 transition", data: { turbo: false }
        - else
          .text-center
            p.text-xs.text-gray-600.mb-3 ログインして自分専用のキーマップを保存
            div data-turbo="false"
              #g_id_onload data-client_id=Rails.application.credentials.dig(:google, :client_id) data-callback="handleCredentialResponse" data-auto_prompt="false"
              .g_id_signin data-type="standard" data-size="medium" data-theme="outline" data-text="sign_in_with" data-shape="rectangular" data-logo_alignment="left"

              javascript:
                function handleCredentialResponse(response) {
                  fetch('/auth/google', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ credential: response.credential })
                  })
                  .then(res => res.json())
                  .then(data => {
                    if (data.success) {
                      window.location.href = data.redirect_url;
                    } else {
                      alert('ログインに失敗しました: ' + (data.error || '不明なエラー'));
                    }
                  })
                  .catch(error => {
                    console.error('Error:', error);
                    alert('ログインエラーが発生しました');
                  });
                }

    / 右メインコンテンツエリア
    main.flex-1.overflow-y-auto style="margin-left: 300px;"
      .container.mx-auto.p-8
        = yield
