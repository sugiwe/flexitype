doctype html
html
  head
    title = content_for(:title) || "Typnix"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Typnix"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/icon.png"

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    script src="https://accounts.google.com/gsi/client" async="" defer="" data-turbo-track="reload"

    / テーマのちらつき防止: ページ読み込み前にdarkクラスを適用
    script
      | (function() {
      |   const theme = localStorage.getItem('theme') || 'system';
      |   if (theme === 'dark') {
      |     document.documentElement.classList.add('dark');
      |   } else if (theme === 'light') {
      |     document.documentElement.classList.remove('dark');
      |   } else if (theme === 'system') {
      |     if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      |       document.documentElement.classList.add('dark');
      |     }
      |   }
      | })();

  body.h-screen.flex.bg-gray-50.dark:bg-gray-900.overflow-hidden.transition-colors
    / 左カラムサイドバー（300px）
    aside.bg-white.dark:bg-gray-800.shadow-lg.flex.flex-col.fixed.h-full.left-0.top-0.z-10.transition-colors style="width: 300px;"
      / ロゴエリア
      .p-6.border-b.border-gray-200.dark:border-gray-700
        = link_to root_path, class: "block", data: { turbo: false } do
          h1.text-2xl.font-bold.text-gray-800.dark:text-white Typnix
          p.text-xs.text-gray-500.dark:text-gray-400.mt-1 分割型キーボード練習

      / ナビゲーションメニュー（スクロール可能エリア）
      nav.flex-1.p-4.overflow-y-auto
        ul.space-y-2
          li
            = link_to root_path, class: "flex items-center px-4 py-3 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400 transition #{current_page?(root_path) ? 'bg-blue-50 dark:bg-blue-900 text-blue-600 dark:text-blue-400 font-semibold' : ''}", data: { turbo: false } do
              svg.w-5.h-5.mr-3 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              span ホーム
          - if logged_in?
            li
              = link_to edit_keymap_path(id: 'current'), class: "flex items-center px-4 py-3 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400 transition #{current_page?(edit_keymap_path(id: 'current')) ? 'bg-blue-50 dark:bg-blue-900 text-blue-600 dark:text-blue-400 font-semibold' : ''}" do
                svg.w-5.h-5.mr-3 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                span キーマップ設定

      / 広告スペース（300x250px - レクタングル中）- 常に表示
      .border-t.border-gray-200.dark:border-gray-700.flex.items-center.justify-center
        .w-full.h-64.bg-gray-200.dark:bg-gray-700.flex.items-center.justify-center
          .text-center
            p.text-xs.text-gray-400.dark:text-gray-500.font-semibold Ad Space
            p.text-xs.text-gray-400.dark:text-gray-500.mt-1 300 x 250

      / テーマ選択（ユーザー情報の上に配置）
      .p-4.border-t.border-gray-200.dark:border-gray-700 data-controller="theme"
        .relative
          / 現在のテーマ表示ボタン
          button.w-full.px-4.py-2.bg-gray-100.dark:bg-gray-700.hover:bg-gray-200.dark:hover:bg-gray-600.text-gray-700.dark:text-gray-200.text-sm.rounded-lg.transition.flex.items-center.justify-between type="button" data-action="click->theme#toggle"
            span.flex.items-center
              span.mr-2 data-theme-target="currentIcon"
                svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              span data-theme-target="currentName" System
            svg.w-4.h-4.transition-transform fill="none" stroke="currentColor" viewBox="0 0 24 24" data-theme-target="chevron"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"

          / ドロップダウンメニュー
          .absolute.bottom-full.left-0.w-full.mb-2.bg-white.dark:bg-gray-700.rounded-lg.shadow-lg.border.border-gray-200.dark:border-gray-600.hidden data-theme-target="dropdown"
            ul.py-2
              li
                button.w-full.px-4.py-2.text-left.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center type="button" data-action="click->theme#select" data-theme-id="light"
                  span.mr-2
                    svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                      path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                  span Light
              li
                button.w-full.px-4.py-2.text-left.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center type="button" data-action="click->theme#select" data-theme-id="dark"
                  span.mr-2
                    svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                      path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                  span Dark
              li
                button.w-full.px-4.py-2.text-left.text-sm.text-gray-700.dark:text-gray-200.hover:bg-gray-100.dark:hover:bg-gray-600.transition.flex.items-center type="button" data-action="click->theme#select" data-theme-id="system"
                  span.mr-2
                    svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                      path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  span System

      / ユーザー情報・認証エリア（常に下部に固定）
      .p-4.border-t.border-gray-200.dark:border-gray-700
        - if logged_in?
          .mb-3
            .flex.items-center.mb-2
              .w-8.h-8.bg-blue-600.dark:bg-blue-500.rounded-full.flex.items-center.justify-center.text-white.font-semibold.mr-2
                = current_user.name[0].upcase
              .flex-1
                p.text-sm.font-semibold.text-gray-800.dark:text-white = current_user.name
                p.text-xs.text-gray-500.dark:text-gray-400.truncate = current_user.email
          = button_to "ログアウト", logout_path, method: :delete, class: "w-full px-4 py-2 bg-gray-600 dark:bg-gray-700 text-white text-sm rounded-lg hover:bg-gray-700 dark:hover:bg-gray-600 transition", data: { turbo: false }
        - else
          .text-center
            p.text-xs.text-gray-600.dark:text-gray-400.mb-3 ログインして自分専用のキーマップを保存
            div data-turbo="false"
              #g_id_onload data-client_id=Rails.application.credentials.dig(:google, :client_id) data-callback="handleCredentialResponse" data-auto_prompt="false"
              .g_id_signin data-type="standard" data-size="medium" data-theme="outline" data-text="sign_in_with" data-shape="rectangular" data-logo_alignment="left"

              javascript:
                function handleCredentialResponse(response) {
                  fetch('/auth/google', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ credential: response.credential })
                  })
                  .then(res => res.json())
                  .then(data => {
                    if (data.success) {
                      window.location.href = data.redirect_url;
                    } else {
                      alert('ログインに失敗しました: ' + (data.error || '不明なエラー'));
                    }
                  })
                  .catch(error => {
                    console.error('Error:', error);
                    alert('ログインエラーが発生しました');
                  });
                }

    / 右メインコンテンツエリア
    main.flex-1.overflow-y-auto.bg-gray-50.dark:bg-gray-900.transition-colors style="margin-left: 300px;"
      .container.mx-auto.p-8
        = yield
