doctype html
html
  head
    title = content_for(:page_title).presence || content_for(:title).presence || t('meta.title')
    = render "layouts/head"

    / OGP設定
    meta property="og:title" content=(content_for(:og_title).presence || t('meta.title'))
    meta property="og:description" content=(content_for(:og_description).presence || t('meta.description'))
    meta property="og:type" content=(content_for(:og_type).presence || "website")
    meta property="og:url" content=(content_for(:og_url).presence || "https://typnix.com")
    meta property="og:image" content=image_url("ogp.png")
    meta property="og:site_name" content="Typnix"
    meta property="og:locale" content="ja_JP"

    / 記事固有のOGPタグ
    - if content_for(:article_published_time).present?
      meta property="article:published_time" content=content_for(:article_published_time)
    - if content_for(:article_author).present?
      meta property="article:author" content=content_for(:article_author)

    / Twitter Card設定
    meta name="twitter:card" content="summary_large_image"
    meta name="twitter:title" content=(content_for(:og_title).presence || t('meta.title'))
    meta name="twitter:description" content=(content_for(:og_description).presence || t('meta.description'))
    meta name="twitter:image" content=image_url("ogp.png")

    = yield :head
    script src="https://accounts.google.com/gsi/client" async="" defer="" data-turbo-track="reload"

  body.h-screen.flex.bg-gray-50.dark:bg-gray-900.overflow-hidden.transition-colors data-controller="sidebar"
    = render "layouts/gtm_noscript"
    / フラッシュメッセージ
    = render "layouts/shared/flash_messages"

    / デスクトップ推奨バナー（モバイルのみ表示）
    = render "layouts/shared/desktop_banner"

    / ハンバーガーメニューボタン（モバイルのみ表示・右下固定・サイドバーの？アイコンの右に配置）
    button.md:hidden.fixed.z-50.w-10.h-10.bg-blue-600.dark:bg-blue-700.text-white.rounded-full.shadow-lg.hover:bg-blue-700.dark:hover:bg-blue-800.transition.flex.items-center.justify-center class="bottom-4 right-4" data-action="click->sidebar#toggle"
      svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"

    / オーバーレイ（モバイルでサイドバー開いている時のみ表示）
    .md:hidden.fixed.inset-0.z-30.hidden.transition-opacity.duration-300 class="bg-black/50" data-sidebar-target="overlay" data-action="click->sidebar#close"

    / 左カラムサイドバー
    = render "layouts/shared/sidebar"

    / 右メインコンテンツエリア
    main.flex-1.overflow-y-auto.bg-gray-50.dark:bg-gray-900.transition-colors class="md:ml-[300px]"
      / モバイル用ロゴヘッダー（モバイルのみ表示・上部中央・スクロールで流れる）
      .md:hidden.bg-white.dark:bg-gray-800.py-3.px-4.flex.justify-center
        = link_to root_path, data: { turbo: false } do
          = image_tag "logo.svg", alt: "Typnix", class: "h-8 dark:brightness-0 dark:invert"

      .container.max-w-6xl.mx-auto.p-4.md:p-8
        = yield
