doctype html
html
  head
    title = content_for(:title) || "Typnix | 垂直配列タイピング練習アプリ"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Typnix"
    meta name="mobile-web-app-capable" content="yes"
    meta name="description" content="Typnix（タイプニックス）は、垂直配列キーボードに特化したタイピング練習アプリです。自分のキーマップで効率的に練習できます。"
    = csrf_meta_tags
    = csp_meta_tag

    / OGP設定
    meta property="og:title" content="Typnix | 垂直配列タイピング練習アプリ"
    meta property="og:description" content="Typnix（タイプニックス）は、垂直配列キーボードに特化したタイピング練習アプリです。自分のキーマップで効率的に練習できます。"
    meta property="og:type" content="website"
    meta property="og:url" content="https://typnix.com"
    meta property="og:image" content=image_url("ogp.png")
    meta property="og:site_name" content="Typnix"
    meta property="og:locale" content="ja_JP"

    / Twitter Card設定
    meta name="twitter:card" content="summary_large_image"
    meta name="twitter:title" content="Typnix | 垂直配列タイピング練習アプリ"
    meta name="twitter:description" content="Typnix（タイプニックス）は、垂直配列キーボードに特化したタイピング練習アプリです。自分のキーマップで効率的に練習できます。"
    meta name="twitter:image" content=image_url("ogp.png")

    = yield :head

    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/apple-touch-icon.png"

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    script src="https://accounts.google.com/gsi/client" async="" defer="" data-turbo-track="reload"

    / テーマのちらつき防止: ページ読み込み前にdarkクラスを適用
    script
      | (function() {
      |   const theme = localStorage.getItem('theme') || 'light';
      |   if (theme === 'dark') {
      |     document.documentElement.classList.add('dark');
      |   } else if (theme === 'light') {
      |     document.documentElement.classList.remove('dark');
      |   } else if (theme === 'system') {
      |     if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      |       document.documentElement.classList.add('dark');
      |     }
      |   }
      | })();

    / Google Tag Manager
    - if ENV['GTM_CONTAINER_ID'].present?
      script
        | (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        | new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        | j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        | 'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        | })(window,document,'script','dataLayer','#{ENV['GTM_CONTAINER_ID']}');

  body.h-screen.flex.bg-gray-50.dark:bg-gray-900.overflow-hidden.transition-colors data-controller="sidebar"
    / Google Tag Manager (noscript)
    - if ENV['GTM_CONTAINER_ID'].present?
      noscript
        iframe src="https://www.googletagmanager.com/ns.html?id=#{ENV['GTM_CONTAINER_ID']}" height="0" width="0" style="display:none;visibility:hidden"
    / フラッシュメッセージ
    = render "layouts/shared/flash_messages"

    / デスクトップ推奨バナー（モバイルのみ表示）
    = render "layouts/shared/desktop_banner"

    / ハンバーガーメニューボタン（モバイルのみ表示・右下固定・サイドバーの？アイコンの右に配置）
    button.md:hidden.fixed.z-50.w-10.h-10.bg-blue-600.dark:bg-blue-700.text-white.rounded-full.shadow-lg.hover:bg-blue-700.dark:hover:bg-blue-800.transition.flex.items-center.justify-center class="bottom-4 right-4" data-action="click->sidebar#toggle"
      svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"

    / オーバーレイ（モバイルでサイドバー開いている時のみ表示）
    .md:hidden.fixed.inset-0.z-30.hidden.transition-opacity.duration-300 class="bg-black/50" data-sidebar-target="overlay" data-action="click->sidebar#close"

    / 左カラムサイドバー
    = render "layouts/shared/sidebar"

    / 右メインコンテンツエリア
    main.flex-1.overflow-y-auto.bg-gray-50.dark:bg-gray-900.transition-colors class="md:ml-[300px]"
      / モバイル用ロゴヘッダー（モバイルのみ表示・上部中央・スクロールで流れる）
      .md:hidden.bg-white.dark:bg-gray-800.py-3.px-4.flex.justify-center
        = link_to root_path, data: { turbo: false } do
          = image_tag "logo.svg", alt: "Typnix", class: "h-8 dark:brightness-0 dark:invert"

      .container.mx-auto.p-4.md:p-8
        = yield
