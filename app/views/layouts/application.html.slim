doctype html
html
  head
    title = content_for(:title) || "Typnix"
    meta name="viewport" content="width=device-width,initial-scale=1"
    meta name="apple-mobile-web-app-capable" content="yes"
    meta name="application-name" content="Typnix"
    meta name="mobile-web-app-capable" content="yes"
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    link rel="icon" href="/icon.png" type="image/png"
    link rel="icon" href="/icon.svg" type="image/svg+xml"
    link rel="apple-touch-icon" href="/apple-touch-icon.png"

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
    script src="https://accounts.google.com/gsi/client" async="" defer="" data-turbo-track="reload"

    / テーマのちらつき防止: ページ読み込み前にdarkクラスを適用
    script
      | (function() {
      |   const theme = localStorage.getItem('theme') || 'system';
      |   if (theme === 'dark') {
      |     document.documentElement.classList.add('dark');
      |   } else if (theme === 'light') {
      |     document.documentElement.classList.remove('dark');
      |   } else if (theme === 'system') {
      |     if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      |       document.documentElement.classList.add('dark');
      |     }
      |   }
      | })();

  body.h-screen.flex.bg-gray-50.dark:bg-gray-900.overflow-hidden.transition-colors
    / 左カラムサイドバー
    = render "layouts/shared/sidebar"

    / 右メインコンテンツエリア
    main.flex-1.overflow-y-auto.bg-gray-50.dark:bg-gray-900.transition-colors style="margin-left: 300px;"
      .container.mx-auto.p-8
        = yield
