/ ページヘッダー
.mb-6
  h2.text-3xl.font-bold.text-gray-800.dark:text-white = @lesson.translated_name
  p.text-sm.text-gray-600.dark:text-gray-400.mt-2
    = @lesson.category.translated_name
    |  •
    = @lesson.translated_description
  / 作成者情報
  .flex.items-center.gap-2.mt-2
    - if @lesson.user.icon_url.present?
      img.w-5.h-5.rounded-full src=@lesson.user.icon_url alt=@lesson.user.display_name
    - if @lesson.official?
      .flex.items-center.gap-1
        svg.w-4.h-4.text-blue-600.dark:text-blue-400 fill="currentColor" viewBox="0 0 20 20"
          path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
        span.text-xs.font-medium.text-gray-700.dark:text-gray-300 Typnix Official
    - else
      span.text-xs.text-gray-600.dark:text-gray-400 = "@#{@lesson.user.username}"

/ メインエリア
.bg-white.dark:bg-gray-800.rounded-lg.shadow-lg.p-8.transition-colors data-controller="typing" data-typing-words-value=@words.to_json data-typing-keymaps-value=@keymaps.to_json data-typing-lesson-info-value=@lesson.to_lesson_info.to_json data-typing-logged-in-value=logged_in? data-typing-grades-value=@grades_with_paths.to_json
  / セッション完了画面（初期は非表示）
  .hidden data-typing-target="completionScreen"
    .text-center.py-12
      / メッセージ
      p.text-lg.text-gray-600.dark:text-gray-300.mb-8 = t('lesson.completion.title')

      / グレードバッジ
      .mb-8
        .mb-4.flex.justify-center
          = image_tag "grade_1_baby.png", alt: "グレード", class: "w-40 h-40", data: { typing_target: "gradeImage" }
        h2.text-4xl.font-bold.mb-2 data-typing-target="gradeName" グレード
        p.text-lg.text-gray-600.dark:text-gray-300 data-typing-target="gradeDescription" 成績を計算中...

      / 統計情報（4列グリッド）
      .grid.grid-cols-2.md:grid-cols-4.gap-4.max-w-3xl.mx-auto.mb-10
        .bg-green-50.dark:bg-green-900.rounded-lg.p-6.transition-colors
          .text-3xl.font-bold.text-green-700.dark:text-green-300 data-typing-target="accuracyDisplay" 100%
          .text-sm.text-gray-600.dark:text-gray-300.mt-2 = t('lesson.completion.accuracy')
        .bg-purple-50.dark:bg-purple-900.rounded-lg.p-6.transition-colors
          .text-3xl.font-bold.text-purple-700.dark:text-purple-300 data-typing-target="wpmDisplay" 0
          .text-sm.text-gray-600.dark:text-gray-300.mt-2 = t('lesson.completion.wpm')
        .bg-blue-50.dark:bg-blue-900.rounded-lg.p-6.transition-colors
          .text-3xl.font-bold.text-blue-700.dark:text-blue-300 data-typing-target="timeDisplay" 0:00
          .text-sm.text-gray-600.dark:text-gray-300.mt-2 = t('lesson.completion.duration')
        .bg-amber-50.dark:bg-amber-900.rounded-lg.p-6.transition-colors
          .text-3xl.font-bold.text-amber-700.dark:text-amber-300 data-typing-target="mistakesDisplay" 0
          .text-sm.text-gray-600.dark:text-gray-300.mt-2 = t('lesson.completion.mistakes')

      / ボタン
      .flex.justify-center.gap-4.flex-wrap
        - if logged_in?
          button.px-8.py-3.bg-gradient-to-r.from-blue-500.to-purple-600.text-white.rounded-lg.hover:from-blue-600.hover:to-purple-700.transition.font-semibold.shadow-lg data-action="click->typing#shareResult" data-typing-target="shareButton"
            svg.inline-block.w-5.h-5.mr-2 fill="currentColor" viewBox="0 0 24 24"
              path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"
            = t('lesson.completion.share_button')
        button.px-8.py-3.bg-blue-600.dark:bg-blue-700.text-white.rounded-lg.hover:bg-blue-700.dark:hover:bg-blue-600.transition.font-semibold data-action="click->typing#restartLesson"
          = t('lesson.completion.retry_button')
        a.px-8.py-3.bg-gray-200.dark:bg-gray-700.text-gray-700.dark:text-gray-200.rounded-lg.hover:bg-gray-300.dark:hover:bg-gray-600.transition.font-semibold href="/" data-turbo="false"
          = t('lesson.completion.home_button')

  / タイピング練習画面（通常時は表示）
  div data-typing-target="lessonScreen"
    / 単語表示エリア（クリックで入力フォーカス）
    .mb-6
      .text-center.mb-2
        .inline-block.px-3.py-1.bg-gray-100.dark:bg-gray-700.rounded-full.text-sm.text-gray-600.dark:text-gray-300.transition-colors data-typing-target="progress"
          = t('lesson.progress', current: 1, total: 20)
      .text-center.mb-3
        p.text-xs.text-gray-500.dark:text-gray-400 = t('lesson.timer_notice')
      .text-center.mb-4.py-10.bg-gray-100.dark:bg-gray-700.rounded-lg.transition-all.cursor-text.select-none data-action="click->typing#focusInput" data-typing-target="displayArea" style="min-height: 140px;"
        .text-5xl.font-mono.tracking-wider.-space-x-2 data-typing-target="display"
          span.text-green-600.dark:text-green-400.font-semibold hel
          span.text-blue-600.dark:text-blue-400.border-b-4.border-blue-600.dark:border-blue-400.font-semibold l
          span.text-gray-400.dark:text-gray-500 o

    / 非表示の入力フィールド（実際の入力を受け取る）
    input.absolute.opacity-0.pointer-events-none type="text" autocomplete="off" data-typing-target="input" data-action="input->typing#handleInput"

    / 操作説明
    .mb-4.text-center
      .inline-flex.items-center.gap-2.px-4.py-2.bg-blue-50.dark:bg-blue-900.border.border-blue-200.dark:border-blue-700.rounded-lg.text-xs.text-blue-800.dark:text-blue-200
        svg.w-4.h-4.shrink-0 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        span = t('lesson.instruction')

    / キーボード表示エリア
    .mt-6
      / キーボードタイプに応じてグリッドを動的に読み込み
      = render "keyboard_grid_#{@keyboard_type}", keymaps: @keymaps

      / 指ガイド（手の形を模したデザイン）
      .mt-8
        .flex.justify-center.gap-12
          / 左手ガイド
          .flex.gap-1.items-end
            .finger-guide.w-12.h-12.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-red-100.dark:bg-red-900.transition.shadow-none data-finger="left-pinky"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 小
            .finger-guide.w-12.h-18.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-yellow-100.dark:bg-yellow-900.transition.shadow-none data-finger="left-ring"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 薬
            .finger-guide.w-12.h-19.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-blue-100.dark:bg-blue-900.transition.shadow-none data-finger="left-middle"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 中
            .finger-guide.w-12.h-18.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-green-100.dark:bg-green-900.transition.shadow-none data-finger="left-index"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 人
            .finger-guide.w-12.h-8.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-gray-100.dark:bg-gray-800.transition.shadow-none data-finger="left-thumb"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 親
          / 右手ガイド
          .flex.gap-1.items-end
            .finger-guide.w-12.h-8.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-gray-100.dark:bg-gray-800.transition.shadow-none data-finger="right-thumb"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 親
            .finger-guide.w-12.h-18.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-green-100.dark:bg-green-900.transition.shadow-none data-finger="right-index"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 人
            .finger-guide.w-12.h-19.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-blue-100.dark:bg-blue-900.transition.shadow-none data-finger="right-middle"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 中
            .finger-guide.w-12.h-18.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-yellow-100.dark:bg-yellow-900.transition.shadow-none data-finger="right-ring"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 薬
            .finger-guide.w-12.h-12.flex.flex-col.items-center.justify-center.border-2.border-b-0.border-gray-300.dark:border-gray-600.rounded-t-full.bg-red-100.dark:bg-red-900.transition.shadow-none data-finger="right-pinky"
              .text-xs.font-semibold.text-gray-800.dark:text-gray-200 小
