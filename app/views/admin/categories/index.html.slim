/ ページヘッダー
.mb-6
  .flex.justify-between.items-center
    div
      h2.text-3xl.font-bold.text-gray-800.dark:text-white カテゴリー管理
      p.text-sm.text-gray-600.dark:text-gray-400.mt-2 レッスンのカテゴリーを管理します
    / 新規作成ボタン
    = link_to new_admin_category_path, class: "px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition" do
      svg.w-5.h-5.inline-block.mr-2 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
      | 新規作成

/ タブナビゲーション
.mb-6
  .border-b.border-gray-200.dark:border-gray-700
    nav.flex.space-x-2 aria-label="Tabs"
      / 全て表示タブ
      = link_to admin_categories_path(tab: "all"), data: { turbo_frame: "category_content" }, class: "group inline-flex items-center gap-2 px-4 py-3 border-b-2 font-medium text-sm transition-colors #{'border-blue-500 text-blue-600 dark:text-blue-400' if @current_tab == 'all'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 dark:hover:border-gray-600' unless @current_tab == 'all'}" do
        span.text-xl 📋
        | 全て表示
      / 有効なタブ
      - Category.available_tabs.each do |tab_key, tab_config|
        = link_to admin_categories_path(tab: tab_key), data: { turbo_frame: "category_content" }, class: "group inline-flex items-center gap-2 px-4 py-3 border-b-2 font-medium text-sm transition-colors #{'border-blue-500 text-blue-600 dark:text-blue-400' if @current_tab == tab_key.to_s} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 dark:hover:border-gray-600' unless @current_tab == tab_key.to_s}" do
          span.text-xl = tab_config[:icon]
          = Category.tab_name(tab_key)

/ Turbo Frame でカテゴリー一覧を表示
= render "category_list"
