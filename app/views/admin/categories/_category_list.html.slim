= turbo_frame_tag "category_content" do
  / カテゴリー一覧（1列横長レイアウト）
  - if @categories.any?
    .grid.gap-4
      - @categories.each do |category|
        .bg-white.dark:bg-gray-800.rounded-lg.shadow-md.border.border-gray-200.dark:border-gray-700.p-6
          / カード全体を左右に分割
          .flex.gap-6
            / 左側: カテゴリー情報（可変幅）
            .flex-1.min-w-0
              / ヘッダー
              .flex.items-start.gap-3.mb-3
                div.flex-1
                  h2.text-xl.font-semibold.text-gray-800.dark:text-white.mb-2 = category.translated_name
                  - if category.translated_description.present?
                    p.text-sm.text-gray-600.dark:text-gray-400 style="white-space: pre-line;" = category.translated_description
                  - else
                    p.text-sm.text-gray-500.dark:text-gray-500.italic 説明なし

              / メタ情報とバッジ
              .flex.items-center.gap-3.flex-wrap
                / タブバッジ
                span.px-3.py-1.bg-blue-100.dark:bg-blue-900.text-blue-800.dark:text-blue-300.text-xs.font-medium.rounded-full
                  = Category.tab_name(category.tab)
                / 公開/非公開バッジ
                - if category.published
                  span.px-2.py-1.bg-green-100.dark:bg-green-900.text-green-700.dark:text-green-200.text-xs.font-medium.rounded-full
                    | 公開中
                - else
                  span.px-2.py-1.bg-gray-100.dark:bg-gray-800.text-gray-700.dark:text-gray-400.text-xs.font-medium.rounded-full
                    | 非公開
                / 表示順
                .flex.items-center.gap-1.text-xs.text-gray-500.dark:text-gray-400
                  svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"
                  span 表示順: #{category.display_order}
                / レッスン数
                .flex.items-center.gap-1.text-xs.text-gray-500.dark:text-gray-400
                  svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  span #{category.lessons.count} レッスン
                / ログイン必須
                - if category.requires_login
                  span.px-2.py-1.bg-yellow-100.dark:bg-yellow-900.text-yellow-700.dark:text-yellow-200.text-xs.font-medium.rounded-full
                    | ログイン必須
                / 有料限定
                - if category.premium
                  span.px-2.py-1.bg-purple-100.dark:bg-purple-900.text-purple-700.dark:text-purple-200.text-xs.font-medium.rounded-full
                    | 有料限定

            / 右側: アクションボタン（固定幅、縦並び）
            .flex.flex-col.gap-2.shrink-0 style="width: 140px;"
              = link_to edit_admin_category_path(category), class: "px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white text-center rounded hover:bg-blue-700 dark:hover:bg-blue-800 transition text-sm" do
                svg.w-4.h-4.inline-block.mr-2 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                  path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                | 編集
              - if category.lessons.exists?
                button.w-full.px-4.py-2.bg-gray-300.dark:bg-gray-700.text-gray-500.dark:text-gray-400.rounded.cursor-not-allowed.text-sm disabled=true title="レッスンが存在するため削除できません"
                  svg.w-4.h-4.inline-block.mr-2 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                  | 削除不可
              - else
                = button_to admin_category_path(category), method: :delete, data: { turbo_confirm: "カテゴリー「#{category.translated_name}」を削除してもよろしいですか？" }, class: "w-full px-4 py-2 bg-gray-500 dark:bg-gray-600 text-white rounded hover:bg-gray-600 dark:hover:bg-gray-500 transition text-sm" do
                  svg.w-4.h-4.inline-block.mr-2 fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                  | 削除
  - else
    .text-center.py-12
      svg.w-16.h-16.mx-auto.text-gray-400.dark:text-gray-600.mb-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
      p.text-gray-500.dark:text-gray-400.mb-4 カテゴリーがありません
      = link_to new_admin_category_path, class: "px-6 py-3 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition inline-flex items-center gap-2" do
        svg.w-5.h-5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
        | 最初のカテゴリーを作成
