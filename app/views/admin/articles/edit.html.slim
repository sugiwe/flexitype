/ ページヘッダー
.mb-6
  .flex.justify-between.items-center
    div
      h2.text-3xl.font-bold.text-gray-800.dark:text-white 記事編集
      p.text-sm.text-gray-600.dark:text-gray-400.mt-2 = @article.title
    / 記事表示リンク
    - if @article.published?
      = link_to "記事を表示", article_path(@article), target: "_blank", class: "text-blue-600 dark:text-blue-400 hover:underline text-sm"

/ フォーム
.bg-white.dark:bg-gray-800.rounded-lg.shadow-md.border.border-gray-200.dark:border-gray-700.p-6
  = render "form", article: @article
