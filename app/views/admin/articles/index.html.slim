/ ページヘッダー
.mb-6
  .flex.justify-between.items-center
    div
      h2.text-3xl.font-bold.text-gray-800.dark:text-white 記事管理
      p.text-sm.text-gray-600.dark:text-gray-400.mt-2 ブログ記事・ガイド記事を管理します
    / 新規作成ボタン
    = link_to new_admin_article_path, data: { turbo_frame: "_top" }, class: "px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition" do
      svg.w-5.h-5.inline-block.mr-2 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
      | 新規記事作成

/ フィルタータブ
.mb-6
  .border-b.border-gray-200.dark:border-gray-700
    nav.flex.space-x-2 aria-label="Tabs"
      = link_to admin_articles_path(filter: "all"), class: "px-4 py-3 border-b-2 font-medium text-sm transition-colors #{'border-blue-500 text-blue-600 dark:text-blue-400' if @filter == 'all'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 dark:hover:border-gray-600' unless @filter == 'all'}" do
        | 全て
        - if @filter == "all"
          span.ml-2.text-xs.px-2.py-1.bg-blue-100.dark:bg-blue-900.rounded-full = Article.count
      = link_to admin_articles_path(filter: "published"), class: "px-4 py-3 border-b-2 font-medium text-sm transition-colors #{'border-blue-500 text-blue-600 dark:text-blue-400' if @filter == 'published'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 dark:hover:border-gray-600' unless @filter == 'published'}" do
        | 公開中
        - if @filter == "published"
          span.ml-2.text-xs.px-2.py-1.bg-blue-100.dark:bg-blue-900.rounded-full = Article.published.count
      = link_to admin_articles_path(filter: "draft"), class: "px-4 py-3 border-b-2 font-medium text-sm transition-colors #{'border-blue-500 text-blue-600 dark:text-blue-400' if @filter == 'draft'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 dark:hover:border-gray-600' unless @filter == 'draft'}" do
        | 下書き
        - if @filter == "draft"
          span.ml-2.text-xs.px-2.py-1.bg-blue-100.dark:bg-blue-900.rounded-full = Article.where(published_at: nil).count
      = link_to admin_articles_path(filter: "scheduled"), class: "px-4 py-3 border-b-2 font-medium text-sm transition-colors #{'border-blue-500 text-blue-600 dark:text-blue-400' if @filter == 'scheduled'} #{'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:text-gray-400 dark:hover:text-gray-300 dark:hover:border-gray-600' unless @filter == 'scheduled'}" do
        | 予約投稿
        - if @filter == "scheduled"
          span.ml-2.text-xs.px-2.py-1.bg-blue-100.dark:bg-blue-900.rounded-full = Article.where("published_at > ?", Time.current).count

/ 記事一覧テーブル
- if @articles.any?
  .bg-white.dark:bg-gray-800.rounded-lg.shadow.overflow-hidden
    table.min-w-full.divide-y.divide-gray-200.dark:divide-gray-700
      thead.bg-gray-50.dark:bg-gray-900
        tr
          th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider タイトル
          th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider カテゴリー
          th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider ステータス
          th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider 閲覧数
          th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider 公開日時
          th.px-6.py-3.text-right.text-xs.font-medium.text-gray-500.dark:text-gray-400.uppercase.tracking-wider 操作
      tbody.bg-white.dark:bg-gray-800.divide-y.divide-gray-200.dark:divide-gray-700
        - @articles.each do |article|
          tr
            td.px-6.py-4.whitespace-nowrap
              .text-sm.font-medium.text-gray-900.dark:text-white = article.title
              .text-xs.text-gray-500.dark:text-gray-400 = article.slug
            td.px-6.py-4.whitespace-nowrap
              span.px-2.py-1.text-xs.font-medium.rounded-full.bg-blue-100.text-blue-800.dark:bg-blue-900.dark:text-blue-300
                = I18n.t("activerecord.enums.article.category.#{article.category}")
            td.px-6.py-4.whitespace-nowrap
              - if article.published?
                span.px-2.py-1.text-xs.font-medium.rounded-full.bg-green-100.text-green-800.dark:bg-green-900.dark:text-green-300 公開中
              - elsif article.published_at && article.published_at > Time.current
                span.px-2.py-1.text-xs.font-medium.rounded-full.bg-yellow-100.text-yellow-800.dark:bg-yellow-900.dark:text-yellow-300 予約投稿
              - else
                span.px-2.py-1.text-xs.font-medium.rounded-full.bg-gray-100.text-gray-800.dark:bg-gray-700.dark:text-gray-300 下書き
            td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-900.dark:text-white
              = number_with_delimiter(article.view_count)
            td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500.dark:text-gray-400
              - if article.published_at
                = l(article.published_at, format: :short)
              - else
                | -
            td.px-6.py-4.whitespace-nowrap.text-right.text-sm.font-medium
              .flex.items-center.justify-end.gap-3
                = link_to "編集", edit_admin_article_path(article), class: "text-blue-600 dark:text-blue-400 hover:underline"
                = button_to "削除", admin_article_path(article), method: :delete, data: { turbo_confirm: "記事「#{article.title}」を削除してもよろしいですか？" }, class: "text-red-600 dark:text-red-400 hover:underline"

  / ページネーション
  .mt-6
    = paginate @articles
- else
  .bg-white.dark:bg-gray-800.rounded-lg.shadow.p-8.text-center
    p.text-gray-500.dark:text-gray-400.mb-4 記事がまだありません
    = link_to new_admin_article_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition" do
      svg.w-5.h-5.mr-2 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
      | 最初の記事を作成
