= form_with model: [:admin, article], local: true, class: "space-y-6" do |f|
  / エラーメッセージ
  - if article.errors.any?
    .bg-red-50.dark:bg-red-900/20.border.border-red-200.dark:border-red-800.rounded-lg.p-4.mb-6
      h3.text-red-800.dark:text-red-200.font-medium.mb-2
        = pluralize(article.errors.count, "個のエラー")
        | がありました
      ul.list-disc.list-inside.text-sm.text-red-700.dark:text-red-300
        - article.errors.full_messages.each do |message|
          li = message

  / タイトル
  .form-group
    = f.label :title, "タイトル", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
    = f.text_field :title, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white", placeholder: "例: 分割キーボードとは？初心者向けガイド", autofocus: true

  / スラッグ（任意）
  .form-group
    = f.label :slug, "スラッグ（URL用、空欄で自動生成）", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
    = f.text_field :slug, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white", placeholder: "例: what-is-split-keyboard"
    p.text-xs.text-gray-500.dark:text-gray-400.mt-1 半角英数字とハイフンのみ使用可能。空欄の場合、タイトルから自動生成されます

  / カテゴリー
  .form-group
    = f.label :category, "カテゴリー", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
    = f.select :category, Article.categories.keys.map { |k| [Article.human_attribute_name("category.#{k}"), k] }, {}, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"

  / 概要
  .form-group
    = f.label :excerpt, "概要（任意）", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
    = f.text_area :excerpt, rows: 3, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white", placeholder: "記事の概要を入力してください（一覧ページで表示されます）"

  / 本文（Markdown）
  .form-group
    = f.label :content, "本文（Markdown形式）", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
    = f.text_area :content, rows: 20, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white font-mono text-sm", placeholder: "# 見出し\n\nここに本文を入力してください..."
    p.text-xs.text-gray-500.dark:text-gray-400.mt-1 Markdown記法が使用できます（見出し、リスト、コードブロックなど）

  / 公開日時
  .form-group
    = f.label :published_at, "公開日時（空欄で下書き）", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
    = f.datetime_local_field :published_at, class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
    p.text-xs.text-gray-500.dark:text-gray-400.mt-1 空欄の場合は下書きとして保存されます。未来の日時を指定すると予約投稿になります

  / アクションボタン
  .flex.items-center.justify-between.pt-4.border-t.border-gray-200.dark:border-gray-700
    = link_to "キャンセル", admin_articles_path, class: "px-4 py-2 text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition"
    .flex.gap-3
      - if article.persisted?
        = f.submit "下書き保存", name: "draft", class: "px-6 py-2 bg-gray-600 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-700 dark:hover:bg-gray-800 transition"
        = f.submit "更新", class: "px-6 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition"
      - else
        = f.submit "下書き保存", name: "draft", class: "px-6 py-2 bg-gray-600 dark:bg-gray-700 text-white rounded-lg hover:bg-gray-700 dark:hover:bg-gray-800 transition"
        = f.submit "公開", class: "px-6 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 transition"
