/ ユーザー詳細ページ

/ 戻るリンク
.mb-4
  = link_to admin_users_path, class: "text-blue-600 dark:text-blue-400 hover:underline text-sm" do
    | ← ユーザー一覧に戻る

/ ページヘッダー
.mb-6
  h2.text-3xl.font-bold.text-gray-800.dark:text-white ユーザー詳細
  p.text-sm.text-gray-600.dark:text-gray-400.mt-2 = "ID: #{@user.id}"

/ ユーザー基本情報
.bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6.mb-6
  h3.text-xl.font-semibold.text-gray-800.dark:text-white.mb-4 基本情報
  .flex.items-center.mb-6
    - if @user.icon_url.present?
      img.w-20.h-20.rounded-full.mr-6 src=@user.icon_url alt=@user.name
    - else
      .w-20.h-20.rounded-full.bg-gray-300.dark:bg-gray-600.flex.items-center.justify-center.mr-6
        span.text-3xl.font-bold.text-gray-600.dark:text-gray-300 = @user.name[0].upcase
    div
      p.text-2xl.font-bold.text-gray-800.dark:text-white = @user.name
      - if @user.username.present?
        p.text-sm.text-gray-600.dark:text-gray-400.mt-1
          = link_to profile_path(@user.username), class: "text-blue-600 dark:text-blue-400 hover:underline", target: "_blank" do
            | @#{@user.username}

  .grid.grid-cols-1.md:grid-cols-2.gap-4.text-sm
    .flex.justify-between.py-2.border-b.border-gray-200.dark:border-gray-600
      span.text-gray-600.dark:text-gray-400 メールアドレス
      span.text-gray-800.dark:text-gray-200 = @user.email
    .flex.justify-between.py-2.border-b.border-gray-200.dark:border-gray-600
      span.text-gray-600.dark:text-gray-400 登録日時
      span.text-gray-800.dark:text-gray-200 = l(@user.created_at, format: :long)
    .flex.justify-between.py-2.border-b.border-gray-200.dark:border-gray-600
      span.text-gray-600.dark:text-gray-400 ログイン回数
      span.text-gray-800.dark:text-gray-200 = "#{@user.sign_in_count}回"
    .flex.justify-between.py-2.border-b.border-gray-200.dark:border-gray-600
      span.text-gray-600.dark:text-gray-400 最終ログイン
      span.text-gray-800.dark:text-gray-200
        - if @user.current_sign_in_at.present?
          = l(@user.current_sign_in_at, format: :long)
          br
          span.text-xs.text-gray-500.dark:text-gray-400
            | （
            = time_ago_in_words(@user.current_sign_in_at)
            | 前）
        - else
          span.text-gray-400 未ログイン

/ 統計情報（共通パーシャル使用）
= render "shared/user_statistics", total_records: @total_records, average_accuracy: @average_accuracy, total_keymaps: @total_keymaps

/ キーマップ一覧
.bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6.mb-6
  h3.text-xl.font-semibold.text-gray-800.dark:text-white.mb-4 キーマップ一覧
  - if @user.keymap_sets.any?
    .space-y-3
      - @user.keymap_sets.each do |keymap_set|
        .bg-gray-50.dark:bg-gray-700.rounded-lg.p-4
          .flex.items-center.justify-between
            div
              p.font-medium.text-gray-800.dark:text-white = keymap_set.name
              - if keymap_set.description.present?
                p.text-sm.text-gray-600.dark:text-gray-400.mt-1 = keymap_set.description
              .flex.items-center.gap-4.mt-2.text-xs.text-gray-500.dark:text-gray-400
                span
                  | キー設定数:
                  = keymap_set.keymaps.count
                span
                  | 作成日:
                  = l(keymap_set.created_at.to_date, format: :default)
            - if keymap_set.is_public
              span.px-3.py-1.bg-green-100.dark:bg-green-900.text-green-800.dark:text-green-200.text-xs.font-medium.rounded 公開中
  - else
    p.text-gray-500.dark:text-gray-400.text-sm キーマップがまだ登録されていません

/ 作成したレッスン（共通パーシャル使用）
= render "shared/published_lessons", published_lessons: @published_lessons

/ 練習履歴一覧
.bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6
  h3.text-xl.font-semibold.text-gray-800.dark:text-white.mb-4 練習履歴

  = render "shared/lesson_records_table", lesson_records: @lesson_records, show_pagination: true
