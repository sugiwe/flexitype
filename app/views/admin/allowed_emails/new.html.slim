/ 許可メールアドレス新規作成ページ
.container.mx-auto.px-4.py-8.max-w-2xl
  h1.text-2xl.font-bold.text-gray-800.dark:text-gray-100.mb-6 許可メールアドレス追加

  .bg-white.dark:bg-gray-900.rounded-lg.shadow.p-6
    = form_with model: @allowed_email, url: admin_allowed_emails_path, class: "space-y-6" do |f|
      / メールアドレス
      .form-group
        = f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
        = f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-gray-100", placeholder: "example@example.com", required: true
        - if @allowed_email.errors[:email].any?
          p.mt-1.text-sm.text-red-600.dark:text-red-400 = @allowed_email.errors[:email].join(", ")

      / メモ
      .form-group
        = f.label :note, "メモ（任意）", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
        = f.text_area :note, class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-gray-100", rows: 3, placeholder: "誰の依頼で追加したか等"
        - if @allowed_email.errors[:note].any?
          p.mt-1.text-sm.text-red-600.dark:text-red-400 = @allowed_email.errors[:note].join(", ")

      / ボタン
      .flex.justify-between.items-center
        = link_to "キャンセル", admin_allowed_emails_path, class: "px-4 py-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100"
        = f.submit "追加する", class: "px-6 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded hover:bg-blue-700 dark:hover:bg-blue-600 transition"
