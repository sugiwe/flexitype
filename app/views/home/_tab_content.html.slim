= turbo_frame_tag "lesson_content" do
  / タブコンテンツ
  .space-y-8
    - categories = categories_for_tab(tab_key)
    - if categories.any?
      - categories.each do |category|
        .bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6.transition-colors
          / カテゴリヘッダー
          .mb-4
            h2.text-2xl.font-bold.text-gray-800.dark:text-white = category.translated_name
            p.text-gray-600.dark:text-gray-400.mt-1 = category.translated_description

          / レッスンカード一覧
          .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-4
            - category.lessons.each do |lesson|
              = link_to lesson_path(id: lesson.id), data: { turbo_frame: "_top" }, class: "relative block bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900 dark:to-indigo-900 border-2 border-blue-200 dark:border-blue-700 rounded-lg p-4 hover:shadow-lg hover:border-blue-400 dark:hover:border-blue-500 transition transform hover:-translate-y-1" do
                .flex.items-start.justify-between.mb-2
                  h3.text-base.font-bold.text-gray-800.dark:text-white = lesson.translated_name
                  .px-2.py-1.bg-blue-100.dark:bg-blue-800.text-blue-700.dark:text-blue-200.text-xs.rounded-full.font-semibold
                    = t('home.items_count', count: lesson.count)
                p.text-sm.text-gray-600.dark:text-gray-300.line-clamp-2.mb-3 = lesson.translated_description
                / 作成者情報
                .flex.items-center.gap-2.pt-3.border-t.border-blue-200.dark:border-blue-700
                  - if lesson.user.icon_url.present?
                    img.w-5.h-5.rounded-full src=lesson.user.icon_url alt=lesson.user.display_name
                  - if lesson.official?
                    .flex.items-center.gap-1
                      svg.w-4.h-4.text-blue-600.dark:text-blue-400 fill="currentColor" viewBox="0 0 20 20"
                        path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                      span.text-xs.font-medium.text-gray-700.dark:text-gray-300 Typnix Official
                  - else
                    span.text-xs.text-gray-600.dark:text-gray-400 = "@#{lesson.user.username}"
                / 矢印アイコンを右下に固定配置
                .absolute.bottom-3.right-3.text-blue-600.dark:text-blue-400.text-lg
                  | →
    - else
      .bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-12.text-center
        .text-6xl.mb-4 📝
        h3.text-xl.font-bold.text-gray-800.dark:text-white.mb-2 準備中です
        p.text-gray-600.dark:text-gray-400 このタブのレッスンは現在準備中です。しばらくお待ちください。
